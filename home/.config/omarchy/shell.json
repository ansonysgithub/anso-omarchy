{
  "bar": {
    "centerAnchor": "omarchy.clock",
    "layout": {
      "center": [
        {
          "id": "omarchy.indicators"
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "format": "dddd HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "id": "omarchy.clock",
          "verticalFormat": "HH\n\u2014\nmm"
        },
        {
          "id": "omarchy.weather"
        },
        {
          "id": "omarchy.system-update"
        }
      ],
      "left": [
        {
          "id": "omarchy.menu"
        },
        {
          "id": "omarchy.workspaces"
        }
      ],
      "right": [
        {
          "id": "anso.tray",
          "pinned": [],
          "hidden": [
            "librepods",
            "indicator-solaar"
          ]
        },
        {
          "id": "anso.statusline",
          "detailLayout": "overview",
          "gpuTemperatureVisibility": {
            "card0": false
          },
          "gpuVisibility": {
            "card0": false
          },
          "layout": "minimal",
          "metrics": [
            "mouse",
            "cpu",
            "heat",
            "gpu",
            "memory",
            "disk",
            "vpn",
            "net",
            "diskio"
          ],
          "showHistory": true
        },
        {
          "id": "omarchy.agents"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "omarchy.power"
        },
        {
          "id": "omarchy.audio"
        }
      ]
    },
    "position": "top",
    "transparent": false
  },
  "idle": {
    "lock": 300,
    "screensaver": 150
  },
  "plugins": [
    {
      "id": "io.github.tallsam.navbar-cat"
    }
  ],
  "version": 1
}
